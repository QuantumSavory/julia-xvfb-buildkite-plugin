#!/usr/bin/env bash
set -euo pipefail
shopt -s extglob

if [[ "$OSTYPE" != linux* ]]; then
    echo "Skipping Xvfb diagnostics on $OSTYPE."
    return 0
fi

if [[ -n "${JULIA_XVFB_WRAPPER_DIR:-}" ]]; then
    rm -f -- "$JULIA_XVFB_WRAPPER_DIR/julia"
    rmdir -- "$JULIA_XVFB_WRAPPER_DIR"
    unset JULIA_XVFB_WRAPPER_DIR
fi
